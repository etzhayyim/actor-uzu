(ns uzu.repository-contract-test
  (:require [kotoba.lang.edn :as edn]
            [kotoba.io :as io]
            [kotoba.test :refer [deftest is]]))

(def root (io/file (System/getProperty "user.dir")))

(deftest canonical-edn-contract
  (doseq [path ["manifest.edn" "schema/schema.edn"
                "schema/ontology.uzu.edn" "data/seed.kotoba.edn"]]
    (is (some? (edn/read-string (slurp (io/file root path)))) path)))

(deftest no-legacy-artifacts
  (is (empty? (filter #(re-find #"\\.(?:go|sh|json|jsonld|bpmn)$" (io/file-name %))
                      (filter #(io/file? %) (io/file-seq root))))))
