{"lexicon" 1, "id" "com.etzhayyim.uzu.organismBeat", "defs" {"main" {"type" "procedure", "description" "Append one beat of a uzu 渦 organism's dissipative loop to the kotoba Datom log (:uzu.beat/*). The ENERGY ledger (:uzu.beat/energy — conserved, depleting) and the INFORMATION free energy (:uzu.beat/free-energy — nats) are SEPARATE fields and must never be conflated into one quantity (G1). Synthetic/simulated organisms only at R0 (:uzu/sourcing :synthetic); there is NO per-person field (G9).", "input" {"encoding" "application/json", "schema" {"type" "object", "required" ["organismId" "age" "regime" "action" "energy" "freeEnergy" "alive"], "properties" {"energy" {"type" "number", "description" ":uzu.beat/energy — the CONSERVED metabolic balance after the beat (energy units, NOT nats)"}, "sourcing" {"type" "string", "enum" ["synthetic" "representative"], "description" "R0 organism beats are :synthetic"}, "age" {"type" "integer", "description" ":uzu.beat/age — beat index (0-based)"}, "beliefOf" {"type" "string", "enum" ["scarce" "benign" "abundant" "hostile"], "description" "the regime the organism BELIEVED most likely"}, "freeEnergy" {"type" "number", "description" ":uzu.beat/free-energy — variational free energy / surprise (INFORMATION, nats; NOT energy units)"}, "spent" {"type" "number", "description" "basal + inference + action + hazard cost this beat"}, "organismId" {"type" "string", "description" ":uzu.beat/of — the organism's id (e.g. \"kurage\")"}, "action" {"type" "string", "enum" ["forage" "flee" "rest" "explore"], "description" "the action chosen by minimizing expected free energy"}, "gained" {"type" "number", "description" "energy drawn from the TRUE regime this beat"}, "regime" {"type" "string", "enum" ["scarce" "benign" "abundant" "hostile"], "description" "the TRUE (hidden) world regime that beat"}, "alive" {"type" "boolean", "description" ":uzu.beat/alive — false once the energy balance reaches zero (self-maintenance is earned, not assumed)"}}}}, "output" {"encoding" "application/json", "schema" {"type" "object", "properties" {"ok" {"type" "boolean"}, "organismId" {"type" "string"}, "txCid" {"type" "string", "description" "kotoba transaction CID (content-addressed append-only Datom log; ADR-2605312345)"}}}}}}}
